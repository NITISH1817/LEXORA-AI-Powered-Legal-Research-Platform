# ========================================================
# AI Legal Intelligence Workbench - Environment Configuration
# ========================================================

# PROJECT SETTINGS
PROJECT_NAME="AI Legal Intelligence Workbench"
API_V1_STR="/api"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# AI / ML KEYS
# Required: Google Gemini API key for embeddings and generation
GEMINI_API_KEY="your_gemini_api_key_here"

# SECURITY SETTINGS
# Required: Generate a secure 256-bit secret key for JWT signing
# You can generate one via python: `openssl rand -hex 32`
SECRET_KEY="generate_a_secure_random_string_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours

# DATABASE SETTINGS
# Defaults to local SQLite if left empty or unmodified
DATABASE_URL="sqlite:///./legal_intel.db"
CHROMA_DB_DIR="./chroma_db"
