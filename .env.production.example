# ==============================================================================
# LEXORA AI-Powered Legal Intelligence Platform — Production Environment Configuration
# ==============================================================================
# IMPORTANT:
# 1. Copy this template to .env on your deployment host: `cp .env.production.example .env`
# 2. Populate all placeholder values before launching the application.
# 3. NEVER commit real production .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Core Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="LEXORA Legal Intelligence Workbench"
API_V1_STR="/api"

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# MANDATORY: Generate a cryptographically strong 256-bit random key (>= 32 chars).
# Example command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS

# Optional JWT signing override (defaults to SECRET_KEY if omitted)
JWT_SECRET_KEY=

# Token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Origins
# ------------------------------------------------------------------------------
# Restrict to your actual authorized production pilot domains (comma-separated).
# Example: https://lexora.pilot.example.com,https://app.lexora.internal
CORS_ORIGINS=https://lexora.pilot.example.com

# ------------------------------------------------------------------------------
# 4. Database & Storage Architecture
# ------------------------------------------------------------------------------
# Single-instance persistent SQLite location (must point to a mounted persistent volume)
DATABASE_URL=sqlite:////app/data/legal_intel.db

# Storage volumes for document ingestion and caching
UPLOAD_DIR=/app/storage/uploads
PROCESSED_DIR=/app/storage/processed
CHROMA_DB_DIR=/app/chroma_db

# File upload limits
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt
CHUNK_SIZE=400
CHUNK_OVERLAP=2
OCR_ENABLED=false

# ------------------------------------------------------------------------------
# 5. AI Synthesis Provider Configuration
# ------------------------------------------------------------------------------
# Google Gemini API Key for legal reasoning and research brief generation.
# If omitted or unavailable, LEXORA operates in DEGRADED MODE (search, comparison,
# timeline extraction, precedent graph, and evaluation remain functional).
GEMINI_API_KEY=YOUR_GEMINI_PRODUCTION_API_KEY_HERE

# Retrieval Hybrid Fusion Weights (RRF)
SEMANTIC_WEIGHT=0.65
KEYWORD_WEIGHT=0.35

# ------------------------------------------------------------------------------
# 6. Privacy-Safe Pilot Telemetry & Audit Logging
# ------------------------------------------------------------------------------
# Master toggle for pilot telemetry logging
PILOT_MONITORING_ENABLED=true

# CRITICAL PRIVACY CONTROL:
# When false (default), raw legal queries are REDACTED to protect confidentiality.
# Must remain false unless pilot participants have explicitly opted into query logging.
PILOT_MONITORING_LOG_QUERIES=false

# Retention period in days before automated log pruning
PILOT_MONITORING_RETENTION_DAYS=30
PILOT_MONITORING_DIR=/app/storage/monitoring
